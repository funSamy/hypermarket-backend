# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/hypermarket?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"
JWT_EXPIRES_IN="7d"

# Application Configuration
APP_URL="http://localhost:3001"
NODE_ENV="development"
PORT=3001

# FAPSHI Payment Gateway Configuration
# Required for all FAPSHI integrations

# API Credentials (Required)
FAPSHI_API_USER="your-api-user-from-fapshi"
FAPSHI_API_KEY="your-api-key-from-fapshi"

# Environment URLs (Required)
FAPSHI_SANDBOX_BASE_URL="https://sandbox.fapshi.com"
FAPSHI_LIVE_BASE_URL="https://api.fapshi.com"

# Webhook Configuration (Optional but recommended)
FAPSHI_WEBHOOK_SECRET="your-webhook-secret-for-signature-validation"

# Merchant Configuration (Optional)
FAPSHI_MERCHANT_ID="your-merchant-id-if-required"
FAPSHI_MERCHANT_NAME="Your Business Name"

# Payment Configuration (Optional)
FAPSHI_DEFAULT_CURRENCY="XAF"
FAPSHI_DEFAULT_REDIRECT_URL="http://localhost:3001/payment-success"
FAPSHI_DEFAULT_CANCEL_URL="http://localhost:3001/payment-cancel"

# Timeout Configuration (Optional)
FAPSHI_REQUEST_TIMEOUT=30000
FAPSHI_RETRY_ATTEMPTS=3

# Logging Configuration (Optional)
FAPSHI_ENABLE_DEBUG_LOGGING=true
FAPSHI_LOG_LEVEL="debug"

# Email Service Configuration (Future use)
# RESEND_API_KEY="your-resend-api-key"

# Rate Limiting Configuration
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Security Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,${FAPSHI_SANDBOX_BASE_URL},${FAPSHI_LIVE_BASE_URL}"
HELMET_ENABLED=true

# File Upload Configuration (Future use)
# MAX_FILE_SIZE=5242880
# UPLOAD_DEST="./uploads"

# Cache Configuration (Future use)
# REDIS_URL="redis://localhost:6379"
# CACHE_TTL=300
